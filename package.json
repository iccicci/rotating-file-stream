{
  "name": "rotating-file-stream",
  "private": true,
  "version": "3.2.10",
  "description": "Opens a stream.Writable to a file rotated by interval and/or size. A logrotate alternative.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "all": "yarn eslint && yarn coverage && yarn build && yarn test:build",
    "build": "bash ./scripts/build.sh",
    "coverage": "TZ=Europe/Rome vitest run --coverage",
    "deps": "npm-check-updates -t minor -u && yarn && npm-check-updates -t latest",
    "eslint": "eslint",
    "prepack": "yarn build",
    "test": "TZ=Europe/Rome vitest run",
    "test:build": "bash ./scripts/test-build.sh"
  },
  "bugs": "https://github.com/iccicci/rotating-file-stream/issues",
  "repository": {
    "url": "git+https://github.com/iccicci/rotating-file-stream.git"
  },
  "keywords": [
    "log",
    "rotate",
    "logrotate"
  ],
  "author": "Daniele Ricci <daniele.icc@gmail.com> (https://github.com/iccicci)",
  "contributors": [
    "cicci (https://www.trinityteam.it/DanieleRicci#en)",
    "allevo",
    "kbirger",
    "jvassev",
    "wangao",
    "rakshith-ravi",
    "Jorge Silva <jorgemsrs@gmail.com>",
    "Jan Christoph Bernack <jc.bernack@gmail.com>",
    "cchare (https://github.com/cchare)"
  ],
  "license": "MIT",
  "funding": {
    "url": "https://www.blockchain.com/btc/address/12p1p5q7sK75tPyuesZmssiMYr4TKzpSCN"
  },
  "readmeFilename": "README.md",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-perfectionist": "5.10.1",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "globals": "17.11.0",
    "npm-check-updates": "23.0.2",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "prettier": {
    "arrowParens": "avoid",
    "jsxBracketSameLine": true,
    "printWidth": 150,
    "trailingComma": "none"
  }
}
